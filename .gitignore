# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
npm-debug.log*

# Secrets and environment
.env
.env.*
*.key
*.pem

# Graphify / build artifacts
graphify-out/
.graphify_*

# Logs
*.log

# Eidolon runtime state (transient, not committed)
.claude/active-persona.json
.claude/.drift-count
.claude/.session-state
.claude/.memory-synced-head

# Security-awareness: the REAL answer key, the issued attestation, and grader keys are never
# committed (only the .example files are). *.pem above already covers the grader signing keys.
references/security-awareness/answer-key.json
.claude/security-attestation.json
security-keys/

# Transient cold-context verify packets
verify-packet/
.firedrill-packet/

# Vendored evolve engine (engine/asi-evolve/): the on-demand venv, run state, and model cache
# are never committed - only the distilled result routes into the tree. (.venv/ above already
# covers engine/.venv; these are anchored for clarity and to catch run artifacts.)
engine/.venv/
engine/.cache/
engine/runs/
.evolve_runs/
**/.evolve_runs/
