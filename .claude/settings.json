{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "effortLevel": "xhigh",
  "maxEffortLevel": "max",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "PowerShell(git push --force *)",
      "Bash(git push * --force *)",
      "PowerShell(git push * --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push -f *)",
      "Bash(git push * -f *)",
      "PowerShell(git push * -f *)",
      "Bash(git config*core.hooksPath*)",
      "PowerShell(git config*core.hooksPath*)",
      "Bash(git filter-branch *)",
      "PowerShell(git filter-branch *)",
      "Bash(git filter-repo *)",
      "PowerShell(git filter-repo *)",
      "Write(**/.claude/settings.local.json)",
      "Edit(**/.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/guard-bash.mjs",
              "--project",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/guard-write.mjs",
              "--project",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/guard-dispatch.mjs",
              "--project",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/post-tool-entry.mjs",
              "--project",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/subagent-start.mjs",
              "--project",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/subagent-stop.mjs",
              "--project",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
